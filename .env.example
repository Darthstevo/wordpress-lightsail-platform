# Optional local environment file for running commands/scripts manually.
# Copy to .env and update with your values.

AWS_REGION=us-east-1
AWS_AVAILABILITY_ZONE=us-east-1a
LIGHTSAIL_INSTANCE_NAME=wordpress-dev-1
LIGHTSAIL_STATIC_IP_NAME=wordpress-dev-ip
LIGHTSAIL_LOAD_BALANCER_NAME=wordpress-dev-lb
LIGHTSAIL_KEY_PAIR_NAME=wordpress-platform-key
LIGHTSAIL_CERTIFICATE_NAME=wordpress-dev-cert
WP_DOMAIN=example.com
WP_ALT_NAMES=["www.example.com"]
ROUTE53_ZONE_ID=Z123EXAMPLE
ROUTE53_A_RECORD_NAMES=["example.com"]
