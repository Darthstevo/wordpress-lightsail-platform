server {
    listen 80;
    server_name {{ wp_domain | default("_") }};
    root {{ wp_docroot }};

    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{ php_fpm_socket }};
    }
}
